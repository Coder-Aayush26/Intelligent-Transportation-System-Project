{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://intelligent-transportation-system-project.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://intelligent-transportation-system-project.onrender.com/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
